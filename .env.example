DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

POSTGRES_DB=lockerdb
POSTGRES_USER=locker
POSTGRES_PASSWORD=locker

DATABASE_URL=postgres://locker:locker@localhost:5433/lockerdb
REDIS_URL=redis://localhost:6379/0

# SMS: console backend is for local development only.
# In production use accounts.sms.HttpSmsBackend and fill the values below.
SMS_BACKEND=accounts.sms.ConsoleSmsBackend
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER=
SMS_TIMEOUT=5
SMS_PHONE_FIELD=to
SMS_MESSAGE_FIELD=message
SMS_SENDER_FIELD=from

# Dedicated key for hashing OTP codes. Must differ from DJANGO_SECRET_KEY.
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
OTP_HMAC_KEY=

# Number of trusted reverse proxies in front of the app (0 = none, use REMOTE_ADDR).
TRUSTED_PROXY_COUNT=0
# Per-IP limits for the OTP endpoints (shared mobile IPs exist, keep them moderate).
OTP_REQUEST_IP_RATE=30/hour
OTP_VERIFY_IP_RATE=60/hour
\n\n# JWT lifetimes.\nJWT_ACCESS_MINUTES=15\nJWT_REFRESH_DAYS=7\n