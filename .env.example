DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

POSTGRES_DB=lockerdb
POSTGRES_USER=locker
POSTGRES_PASSWORD=locker

DATABASE_URL=postgres://locker:locker@localhost:5433/lockerdb
REDIS_URL=redis://localhost:6379/0

# SMS: console backend is for local development only.
# In production use accounts.sms.HttpSmsBackend and fill the values below.
SMS_BACKEND=accounts.sms.ConsoleSmsBackend
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER=
SMS_TIMEOUT=5
SMS_PHONE_FIELD=to
SMS_MESSAGE_FIELD=message
SMS_SENDER_FIELD=from

# Dedicated key for hashing OTP codes. Must differ from DJANGO_SECRET_KEY.
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
OTP_HMAC_KEY=

# Number of trusted reverse proxies in front of the app (0 = none, use REMOTE_ADDR).
TRUSTED_PROXY_COUNT=0
# Per-IP limits for the OTP endpoints (shared mobile IPs exist, keep them moderate).
OTP_REQUEST_IP_RATE=30/hour
OTP_VERIFY_IP_RATE=60/hour
TOKEN_IP_RATE=120/hour

# JWT lifetimes.
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7

# Parcels.
# The storage period counts from the moment the parcel is created.
PARCEL_STORAGE_DAYS=7
# How long a stored response can be replayed with the same Idempotency-Key.
IDEMPOTENCY_TTL_HOURS=24
# The locker device the API talks to. The simulator is for local runs and tests
# only; a real deployment needs a driver (see docs/known-gaps.md).
DEVICE_BACKEND=devices.simulator.SimulatedDevice
# Per-IP limit of the customer pickup endpoint.
PICKUP_IP_RATE=30/hour

# Celery. The broker uses its own Redis database, separate from the cache.
CELERY_BROKER_URL=redis://localhost:6379/1
# Seconds between runs of the beat tasks.
PARCEL_EXPIRY_INTERVAL_SECONDS=300
PICKUP_RECOVERY_INTERVAL_SECONDS=60
PURGE_INTERVAL_SECONDS=86400
# A pickup stuck in PICKUP_IN_PROGRESS this long is failed. Keep it far above any
# device timeout.
PICKUP_RECOVERY_MINUTES=5
# Closed or expired OTP challenges are deleted after this many days. It must be
# longer than the OTP rate window, which is one hour.
OTP_CHALLENGE_RETENTION_DAYS=30

# HTTPS hardening. With DJANGO_DEBUG off, these three default to on:
# SECURE_SSL_REDIRECT=1
# SESSION_COOKIE_SECURE=1
# CSRF_COOKIE_SECURE=1
# Seconds a browser must insist on HTTPS (0 = off). Browsers remember it, so start
# small (3600) and raise it once HTTPS works everywhere.
SECURE_HSTS_SECONDS=0
# Set to 1 only if a reverse proxy terminates TLS AND sets (overwrites) the
# X-Forwarded-Proto header; otherwise a client could fake HTTPS. It is needed
# together with SECURE_SSL_REDIRECT, or every request looks like plain HTTP and
# is redirected forever.
BEHIND_TLS_PROXY=0
